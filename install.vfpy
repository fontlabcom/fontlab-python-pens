#FLM: Install into FontLab with fontlab-instamix
# this_file: stub/install.vfpy
"""Stdlib bootstrap. The root installer is generated from this template."""
import hashlib
import importlib
import io
import json
import os
import shutil
import sys
import tempfile
import urllib.request
import zipfile
from email.parser import BytesParser
from pathlib import Path, PurePosixPath

HERE = Path(__file__).resolve().parent
PKG = "fontlab_instamix"
PYPI = "https://pypi.org/pypi/fontlab-python-instamix/json"
SELF_INSTALL = False


def site():
    data = os.environ.get("FONTLAB_DATA_DIR")
    try:
        fontlab = importlib.import_module("fontlab")
    except ImportError:
        fontlab = None
    version = f"{sys.version_info.major}.{sys.version_info.minor}" if fontlab else "3.11"
    if not data:
        if fontlab is None:
            raise RuntimeError("run inside FontLab or set FONTLAB_DATA_DIR")
        data = fontlab.flPreferences().dataPathDefault
        data = data() if callable(data) else data
    root = Path(str(data)).expanduser()
    target = root / "python" / version / "site-packages"
    if not target.resolve().is_relative_to(root.resolve()):
        raise RuntimeError("site-packages escapes the FontLab data folder")
    return target


def download(target, url=PYPI):
    local = sorted([*HERE.glob("dist/fontlab_python_instamix-*-py3-none-any.whl"),
                    *(HERE.parent / "fontlab-python-instamix" / "dist").glob("fontlab_python_instamix-*-py3-none-any.whl")])
    if len(local) > 1:
        raise RuntimeError("multiple local instamix wheels; keep only the intended version")
    if local:
        blob = local[0].read_bytes()
    else:
        with urllib.request.urlopen(url, timeout=60) as response:
            info = json.load(response)
        wheel = next((u for u in info["urls"] if u["packagetype"] == "bdist_wheel"
                      and u["filename"].endswith("-py3-none-any.whl")), None)
        if wheel is None:
            raise RuntimeError("no compatible fontlab-instamix wheel on PyPI")
        with urllib.request.urlopen(wheel["url"], timeout=120) as response:
            blob = response.read()
        if hashlib.sha256(blob).hexdigest() != wheel["digests"]["sha256"]:
            raise RuntimeError("fontlab-instamix wheel failed its sha256 check")
    with zipfile.ZipFile(io.BytesIO(blob)) as archive:
        names = archive.namelist()
        roots = {n.split("/")[0] for n in names}
        infos = [r for r in roots if r.startswith("fontlab_python_instamix-") and r.endswith(".dist-info")]
        if len(infos) != 1 or roots != {PKG, infos[0]}:
            raise RuntimeError("unexpected wheel contents")
        metadata = BytesParser().parsebytes(archive.read(infos[0] + "/METADATA"))
        if metadata["Name"] != "fontlab-python-instamix" or not metadata["Version"]:
            raise RuntimeError("incorrect wheel metadata")
        required = {PKG + "/__init__.py", PKG + "/legacy.py", infos[0] + "/RECORD",
                    infos[0] + "/WHEEL", infos[0] + "/licenses/LICENSE"}
        if not required.issubset(names):
            raise RuntimeError("incomplete wheel")
        if len(names) != len(set(names)):
            raise RuntimeError("duplicate wheel members")
        for member in archive.infolist():
            path = PurePosixPath(member.filename)
            if path.is_absolute() or ".." in path.parts or "\\" in member.filename or ":" in member.filename:
                raise RuntimeError("unsafe wheel member")
            if (member.external_attr >> 16) & 0o170000 == 0o120000:
                raise RuntimeError("wheel symlinks are unsupported")
        archive.extractall(target)


def remove(path):
    if path.is_symlink() or path.is_file():
        path.unlink()
    elif path.is_dir():
        shutil.rmtree(path)


def required_api():
    importlib.import_module(PKG + ".legacy")
    extension = importlib.import_module(PKG + ".extension")
    if not callable(getattr(extension, "preflight_plugin_migration", None)):
        raise ImportError("fontlab_instamix.extension.preflight_plugin_migration must be callable")
    gui = importlib.import_module(PKG + ".gui")
    if not callable(getattr(gui, "message", None)):
        raise ImportError("fontlab_instamix.gui.message must be callable")
    bootstrap = importlib.import_module(PKG + ".bootstrap")
    if not callable(getattr(bootstrap, "_legacy_rollback", None)):
        raise ImportError("fontlab_instamix.bootstrap._legacy_rollback must be callable")
    if not SELF_INSTALL:
        if not callable(getattr(bootstrap, "install_project", None)):
            raise ImportError("fontlab_instamix.bootstrap.install_project must be callable")
    return importlib.import_module(PKG)


def ensure(force=False):
    if not force:
        try:
            return required_api()
        except ImportError:
            pass
    target = site()
    target.mkdir(parents=True, exist_ok=True)
    temporary = Path(tempfile.mkdtemp(prefix=".instamix-", dir=target))
    stage, backup = temporary / "new", temporary / "old"
    saved, placed = [], []
    modules = {k: v for k, v in sys.modules.items() if k == PKG or k.startswith(PKG + ".")}
    path_added = str(target) not in sys.path
    recovered = True
    try:
        stage.mkdir()
        download(stage)
        backup.mkdir()
        previous = [target / PKG, *target.glob("fontlab_python_instamix-*.dist-info")]
        for old in previous:
            if old.exists() or old.is_symlink():
                old.rename(backup / old.name)
                saved.append(old)
        for item in stage.iterdir():
            destination = target / item.name
            item.rename(destination)
            placed.append(destination)
        for name in list(sys.modules):
            if name == PKG or name.startswith(PKG + "."):
                del sys.modules[name]
        if path_added:
            sys.path.insert(0, str(target))
        importlib.invalidate_caches()
        return required_api()
    except BaseException:
        recovered = False
        for item in reversed(placed):
            remove(item)
        for old in reversed(saved):
            (backup / old.name).rename(old)
        for name in list(sys.modules):
            if name == PKG or name.startswith(PKG + "."):
                del sys.modules[name]
        sys.modules.update(modules)
        if path_added and str(target) in sys.path:
            sys.path.remove(str(target))
        importlib.invalidate_caches()
        recovered = True
        raise
    finally:
        # Keep recovery bytes if restoring the old installation itself fails.
        if recovered:
            shutil.rmtree(temporary)


if __name__ != "install_vfpy_import":
    # Validate context even when reusing an already installed provider.
    site()
    ensure(force=SELF_INSTALL)
    from fontlab_instamix import gui
    if SELF_INSTALL:
        gui.message(f"Installed fontlab-instamix into {site()}")
    else:
        from fontlab_instamix import bootstrap
        gui.message("\n".join(f"Installed {r['id']} {r['version']}" for r in bootstrap.install_project(__file__)))
